ENV=prod
# Railway: reference the Postgres plugin -> ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:pass@host:5432/sipp
# Required: at least 32 UTF-8 bytes; generate a unique random secret:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
OPENROUTER_API_KEY=
# api | worker
SERVICE_ROLE=api

# Models per stage (OpenRouter slugs) — check exact slugs on openrouter.ai/models
MODEL_INTERPRETATION=openai/gpt-6-luna
MODEL_CURRICULUM=anthropic/claude-opus-5.5
MODEL_MAPPING=openai/gpt-6.1-sol
MODEL_PLANNING=openai/gpt-6-luna
MODEL_WRITING=openai/gpt-6-luna
MODEL_REVIEW=openai/gpt-6-luna
MODEL_ESCALATION=openai/gpt-6.1-sol
MODEL_SOLVE=openai/gpt-6-luna
# SOLVE_ENABLED=false
# LLM_REASONING={"planning":"low","review":"low"}
# json_schema (structured outputs) | json_object (if a model rejects json_schema)
LLM_RESPONSE_FORMAT=json_schema

WORKER_CONCURRENCY=3
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMITS={"register":5,"login":20,"refresh":30,"forgot":5,"reset":10}
AUTH_PASSWORD_WORKERS=2
MAX_COST_PER_DAY_USD=1.0
MAX_GLOBAL_COST_PER_DAY_USD=50.0
# Estimate reserved for each paid attempt; unknown costs retain this amount.
LLM_RESERVATION_COST_USD=0.05
LLM_MAX_CONCURRENT_PER_USER=5

# The iOS app (capacitor://localhost) and the dev server
CORS_ORIGINS=capacitor://localhost,http://localhost:5173

# App Store subscriptions through RevenueCat (billing stays off until both are set)
REVENUECAT_SECRET_KEY=
# Same value as the Authorization header set on the RevenueCat webhook
REVENUECAT_WEBHOOK_AUTH=
# STORE_PRODUCT_BASIC_MONTH=sipp_basic_month
# STORE_PRODUCT_BASIC_YEAR=sipp_basic_year
# STORE_PRODUCT_PLUS_MONTH=sipp_plus_month
# STORE_PRODUCT_PLUS_YEAR=sipp_plus_year
# Length of the free introductory offer set on App Store Connect, shown in the app
TRIAL_DAYS=7

# Reminders through APNs (a .p8 key from developer.apple.com, "Keys"); off when empty
APNS_KEY_ID=
APNS_TEAM_ID=
# The .p8 file's contents; on one line, line breaks as \n
APNS_PRIVATE_KEY=
APNS_TOPIC=app.sipp

# Password reset codes by email (resend.com); without a key, dev logs the code and nothing is sent
RESEND_API_KEY=
EMAIL_FROM=Sipp <hello@sipp.app>
