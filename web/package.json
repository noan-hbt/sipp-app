{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test tests/session.test.mjs",
    "test:browser": "node --test tests/*.browser.mjs",
    "ios": "tsc -b && vite build --mode ios && cap sync ios",
    "ios:open": "cap open ios",
    "ios:assets": "capacitor-assets generate --ios --iconBackgroundColor \"#F1EDE7\" --splashBackgroundColor \"#FBF5EE\" --splashBackgroundColorDark \"#17130f\""
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@revenuecat/purchases-capacitor": "13.7.0",
    "@sentry/react": "^11.6.0",
    "@tanstack/react-query": "^5.104.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "motion": "^14.0.0",
    "posthog-js": "^1.438.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  }
}
